{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "baseBranch": "main",
  "changedFilePatterns": [
    "apps/cli/src/**",
    "apps/web/src/**",
    "apps/web/index.html",
    "apps/web/vite.config.ts",
    "services/**",
    "compose.yaml",
    "bun.lock"
  ],
  "access": "restricted",
  "ignore": [],
  "fixed": [],
  "linked": [],
  "format": "oxfmt",
  "updateInternalDependencies": "patch",
  "commit": false,
  "changelog": "@changesets/cli/changelog",
  "privatePackages": {
    "version": true,
    "tag": true
  }
}
