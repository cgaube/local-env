exports[`local-env status says what to run when nothing is set up 1`] = `
"│
◇  Core services
│  ▲ Docker is not running
│
◇  Domain
│  ▲ Not set up yet. Run \`local-env setup\`.
│
◇  Sources
│  None. Add one with \`local-env sources add <repo>\`.
│
◇  Routes
│  None while the proxy is stopped"
`;

exports[`local-env status shows the services, domain, sources and routes 1`] = `
"│
◇  Core services
│  dashboard        healthy    https://local-env.local-env-e2e.test  Lists routes, core services and sources
│  dockhand         running    http://localhost:3000                 Docker UI: deploy and manage stacks from your templates
│  nginx-proxy      running    ports 80, 443                         HTTPS proxy: serves every container with a VIRTUAL_HOST
│  proxy-connector  running                                          Connects containers with a VIRTUAL_HOST to the proxy
│
◇  Domain
│  local-env-e2e.test: *.local-env-e2e.test valid until 2126-10-07
│
◇  Sources
│  None. Add one with \`local-env sources add <repo>\`.
│
◇  Routes
│  https://mail.local-env-e2e.test      mail      running
│  https://db-admin.local-env-e2e.test  db-admin  restarting
