{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "#services/*": ["./services/*"],
      "#cli/*": ["./apps/cli/src/*"],
      "#ui/*": ["./apps/web/src/*"]
    }
  }
}
