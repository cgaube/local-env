// Renovate (https://docs.renovatebot.com), run by the renovate workflow
// (.github/workflows/renovate.yml). It reads package.json and bun.lock,
// mise.toml, compose.yaml, the Dockerfiles in services/ and the GitHub Actions
// in .github/workflows/.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Every update in a single pull request, majors included
    'group:all',
    // On the first day of the month, before 4am UTC: the workflow runs at 1am
    'schedule:monthly',
  ],
  // sourcery-review: Sourcery reviews only the pull requests with this label
  labels: ['dependencies', 'sourcery-review'],
  // package.json ranges follow the latest versions
  rangeStrategy: 'bump',
  // "update all dependencies", like our own commit messages
  commitMessageAction: 'update',
  // Only versions out for 3 days: most bad releases are pulled by then
  minimumReleaseAge: '3 days',

  // Security fixes skip the schedule, the group and the release age: one pull
  // request per vulnerable package, opened on the next daily run. The
  // vulnerabilities come from osv.dev, which includes GitHub's advisories.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ['dependencies', 'security', 'sourcery-review'],
  },

  // CI wants a changeset when bun.lock or the images change: one patch
  // changeset per pull request, in the same commit. The workflow allows this
  // command (RENOVATE_ALLOWED_COMMANDS).
  postUpgradeTasks: {
    commands: ['sh .github/scripts/renovate-changeset.sh {{{branchName}}}'],
    fileFilters: ['.changeset/*.md'],
    executionMode: 'branch',
  },
}
