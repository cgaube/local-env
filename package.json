{
  "name": "local-env",
  "private": true,
  "type": "module",
  "version": "0.1.1",
  "license": "MIT",
  "scripts": {
    "cleanup": "rm -f .*.bun-build",
    "compile": "bun run build:web && bun run typecheck && bun build apps/cli/src/main.ts --compile --compress --target=bun-darwin-arm64 --outfile local-env && bun run cleanup",
    "local-env": "bun apps/cli/src/main.ts",
    "dev": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/cli && tsc -b apps/web",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run test:cli && bun run test:web",
    "test:cli": "bun apps/cli/tests/run.ts --dots",
    "test:cli:unit": "bun apps/cli/tests/run.ts apps/cli/tests/unit",
    "test:cli:e2e": "bun apps/cli/tests/run.ts apps/cli/tests/e2e",
    "test:cli:bin": "bun run compile && LOCAL_ENV_BIN=./local-env bun apps/cli/tests/run.ts apps/cli/tests/e2e",
    "test:cli:coverage": "bun test apps/cli/tests/unit --coverage",
    "test:web": "vitest run --config apps/web/vite.config.ts",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "prepare": "bun run compile",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.8.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
