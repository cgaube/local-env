{
  "name": "local-env",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "cleanup": "rm -f .*.bun-build",
    "compile": "bun run typecheck && bun build src/main.ts --compile --compress --target=bun-darwin-arm64 --outfile local-env && bun run cleanup",
    "local-env": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun tests/run.ts --dots",
    "test:unit": "bun tests/run.ts tests/unit",
    "test:e2e": "bun tests/run.ts tests/e2e",
    "test:bin": "bun run compile && LOCAL_ENV_BIN=./local-env bun tests/run.ts tests/e2e",
    "test:coverage": "bun test tests/unit --coverage",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "prepare": "bun run compile",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.8.1",
    "@types/bun": "^1.4.4",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
