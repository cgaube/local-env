// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`local-env sources list summarizes the content of each source 1`] = `
"│
◇  acme
│  <TMP>/repos/acme
│  3 docker templates, 1 ansible role
│
◇  empty
│  <TMP>/repos/empty
│  empty"
`;

exports[`local-env sources list shows whether the sources that need a registry login have one 1`] = `
"│
◇  acme
│  <TMP>/repos/acme
│  1 docker template
│  ✔ ghcr-io  ghcr.io  logged in as octocat
│
◇  beta
│  <TMP>/repos/beta
│  1 docker template
│  ✔ ghcr-io  ghcr.io  logged in as octocat
│  ▲ quay-io  quay.io  no login: local-env sources login beta --login quay-io
│
◇  plain
│  <TMP>/repos/plain
│  1 docker template"
`;
